#!/usr/bin/env bash
# Entry point. Symlink this onto your PATH (see README); it resolves its real location.
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
root="$(cd -P "$(dirname "$src")" && pwd)"
export FOUNDRY_ROOT="$root"
export PYTHONPATH="$root/src"
exec uv run --quiet --no-project --python 3.12 python -m foundry "$@"
